generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================================
// Auth
// ==========================================================================

// A user of the mobile app. Authenticates via username+password OR phone OTP —
// either identity may be absent depending on which path a user signed up through.
model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  username        String?   @unique
  passwordHash    String?
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  lastOtpSentAt   DateTime?
  name            String?
  state           String?
  dateOfBirth     DateTime?
  createdAt       DateTime  @default(now())

  // Streak freezes: protect the daily streak from breaking when a day is
  // missed. `frozenDates` records which calendar days were auto-covered by
  // a freeze, so streak/calendar computations can treat them as active days
  // without them counting toward "real" activity stats. See lib/streak-freeze.ts.
  //
  // `streakFreezesAvailable` is this month's free allowance: refilled to 2 on
  // the first visit of each month (`freezesRefilledFor` = "YYYY-MM"), unused
  // ones don't roll over. `paidStreakFreezes` are bought (₹5 each) once the
  // free ones are gone and never expire. Free ones are spent first.
  streakFreezesAvailable Int        @default(2)
  paidStreakFreezes      Int        @default(0)
  freezesRefilledFor     String?
  streakFreezesUsed      Int        @default(0)
  frozenDates            DateTime[] @default([])

  // Internal/QA accounts — always treated as having an active subscription,
  // regardless of `isPremium` or the Subscription row below. See lib/entitlement.ts.
  isTestUser Boolean @default(false)
  // Fast-read cache of "does this user currently have paid access" — kept in
  // sync with `subscription.status` by the checkout-verify and webhook routes
  // (see app/api/payments/*). Source of truth is still the Subscription row;
  // this field just avoids a join on every stage/question request.
  isPremium  Boolean @default(false)

  attempts               QuizAttempt[]
  refreshTokens          RefreshToken[]
  stageProgress          UserStageProgress[]
  questionProgress       UserQuestionProgress[]
  dailyChallengeProgress UserDailyChallengeProgress[]
  subscription           Subscription?
  payments               Payment[]
  streakFreezePurchases  StreakFreezePurchase[]
  streakFreezeUses       StreakFreezeUse[]
  profileCompleted       Boolean                      @default(false)
  profile                UserProfile?
  studyPlanGoals         StudyPlanGoal[]
  dailyTasks             DailyTask[]
}

// ==========================================================================
// Study plan — recurring daily goals the student configures ("clear 2 stages
// a day"). Each day's tasks are snapshotted into DailyTask the first time
// that day is read (no cron, same as DailyChallenge), so editing the plan
// changes today and later days but never rewrites past reports. Progress is
// always derived from real activity on that day — see lib/study-plan.ts.
// ==========================================================================

enum StudyGoalType {
  STAGES // complete N category practice stages
  QUESTIONS // answer N questions (any practice mode)
  DAILY_CHALLENGE // finish the daily challenge
  FULL_TEST // complete N full-paper tests
}

model StudyPlanGoal {
  id        Int           @id @default(autoincrement())
  userId    String
  type      StudyGoalType
  target    Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model DailyTask {
  id     Int           @id @default(autoincrement())
  userId String
  // UTC calendar day (midnight), matching how streaks bucket activity.
  date   DateTime      @db.Date
  type   StudyGoalType
  target Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@index([userId, date])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  fullName         String
  targetExam       String   @default("UPSC_CSE")
  preparationLevel String
  targetAttempt    String?
  preparationFocus String   @default("BOTH")
  // Onboarding answers: where they heard about Radiance (INSTAGRAM_FACEBOOK,
  // FRIENDS, GOOGLE, OTHER) and how long they've prepared (NEW, UNDER_1_YEAR,
  // ONE_TO_THREE_YEARS, OVER_3_YEARS).
  referralSource      String?
  preparationDuration String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================================================
// Billing — one recurring Razorpay subscription per user (₹30/month "unlock
// everything" plan). Status mirrors Razorpay's subscription lifecycle; kept
// current by verify-subscription (first payment) and the webhook (renewals/
// cancellations/failures) — see app/api/payments/*.
// ==========================================================================

enum SubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  razorpaySubscriptionId String             @unique
  razorpayPlanId         String
  status                 SubscriptionStatus @default(CREATED)
  currentStart           DateTime?
  currentEnd             DateTime?
  // Autopay bookkeeping, mirrored from Razorpay's subscription entity by the
  // webhook: when the next automatic charge is due and how many cycles have
  // been paid so far.
  chargeAt               DateTime?
  paidCount              Int                @default(0)
  // First time this subscription became ACTIVE, and when autopay was stopped
  // (by the user, an admin, or Razorpay giving up on failed charges).
  activatedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

// One row per Razorpay charge against a subscription (the first payment at
// checkout and every autopay renewal after it). Written idempotently, keyed
// on razorpayPaymentId, by verify-subscription and the subscription.charged
// webhook — whichever arrives first.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  razorpayPaymentId String        @unique
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CAPTURED)
  method            String?
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([paidAt])
}

// ==========================================================================
// Streak freezes — see lib/streak-freeze.ts
// ==========================================================================

// The streak freeze rules, editable from the admin panel. A single row
// (id 1); when it's missing the defaults below apply.
model StreakFreezeSettings {
  id           Int      @id @default(1)
  freePerMonth Int      @default(2)
  pricePaise   Int      @default(500)
  maxPaid      Int      @default(5)
  updatedAt    DateTime @updatedAt
}

enum StreakFreezePurchaseStatus {
  CREATED
  PAID
  FAILED
}

// One order for bought streak freezes (₹5 each). Created when the student
// taps "buy", marked PAID once payment is confirmed (Razorpay order + payment
// ids are filled in then), which adds `quantity` to User.paidStreakFreezes.
model StreakFreezePurchase {
  id                String                     @id @default(cuid())
  userId            String
  quantity          Int                        @default(1)
  amountPaise       Int
  status            StreakFreezePurchaseStatus @default(CREATED)
  // Bought from the "restore your streak" offer rather than to stock up.
  forRestore        Boolean                    @default(false)
  razorpayOrderId   String?                    @unique
  razorpayPaymentId String?                    @unique
  createdAt         DateTime                   @default(now())
  paidAt            DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

enum StreakFreezeSource {
  FREE
  PAID
}

// One row each time a freeze covers a missed day — free or bought — so the
// admin panel can chart usage over time.
model StreakFreezeUse {
  id        String             @id @default(cuid())
  userId    String
  day       DateTime
  source    StreakFreezeSource
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// A rotating opaque refresh token, identified to clients by its raw value.
// Only the token's hash is stored — a DB leak doesn't hand out usable tokens.
// Access tokens are short-lived signed JWTs (see lib/jwt.ts) and are verified
// by signature alone, with no DB row involved.
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])
}

// ==========================================================================
// Shared taxonomy — used by both live quiz questions and staged import questions
// ==========================================================================

// Subject used for category-wise practice (History, Polity, Economy, ...).
model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Gamified stage-mode presentation — see Stage below. All optional/defaulted
  // so existing categories keep working before anyone sets these.
  foodWorldName String?
  icon          String?
  color         String?
  displayOrder  Int     @default(0)
  isActive      Boolean @default(true)

  subcategories     Subcategory[]
  questions         Question[]
  draftQuestions    DraftQuestion[]
  attemptCategories AttemptCategory[]
  stages            Stage[]
  sectionAttempts   QuizAttempt[]     @relation("AttemptSection")
}

// Finer-grained topic within a Category, used by the import/review pipeline.
model Subcategory {
  id         Int    @id @default(autoincrement())
  name       String
  categoryId Int

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  draftQuestions DraftQuestion[]

  @@unique([name, categoryId])
}

// Free-form label attached to draft questions during import/review.
model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  questions QuestionTag[]
}

// ==========================================================================
// Live quiz-serving models
// ==========================================================================

// "Prelims GS1", "Prelims CSAT", "Mains GS1", etc.
// Kept as a table (not an enum) so new exam types can be added with a row insert, no migration.
model ExamType {
  id   Int    @id @default(autoincrement())
  code String @unique // e.g. "PRELIMS_GS1"
  name String // e.g. "Prelims General Studies I"

  papers QuestionPaper[]
}

// One official past-year paper, e.g. UPSC Prelims GS1 2026.
model QuestionPaper {
  id         Int     @id @default(autoincrement())
  year       Int
  examTypeId Int
  title      String? // optional display label

  examType  ExamType      @relation(fields: [examTypeId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]

  @@unique([examTypeId, year])
}

// A reviewed, quiz-ready question. Populated either directly (seed-2026-prelims-gs1.ts)
// or promoted from a DraftQuestion once it clears review.
model Question {
  id              Int                @id @default(autoincrement())
  // Position in the original printed paper (Q1, Q2, ...). Null for questions
  // not taken from a past paper. Full-paper tests are served in this order.
  questionNo      Int?
  text            String
  explanation     String?
  // Bulleted "remember this" / "also revise" cram points shown alongside the
  // explanation on the results/review screen — distinct from the prose explanation.
  revisionPoints  String?
  categoryId      Int
  questionPaperId Int?
  // True for questions with no valid answer key entry (e.g. officially dropped by UPSC,
  // or a source transcription defective enough that no option can be marked correct).
  // Scored as correct for every user, regardless of selection — matching how UPSC itself
  // handles voided questions (full marks to all candidates).
  isVoided        Boolean            @default(false)
  questionImage   String?
  // Not yet curated per-question — defaults every existing and new question
  // to MEDIUM until someone reviews and assigns real difficulty.
  difficulty      QuestionDifficulty @default(MEDIUM)

  category              Category                 @relation(fields: [categoryId], references: [id])
  questionPaper         QuestionPaper?           @relation(fields: [questionPaperId], references: [id])
  options               Option[]
  answers               AttemptAnswer[]
  stageEntries          StageQuestion[]
  userProgress          UserQuestionProgress[]
  dailyChallengeEntries DailyChallengeQuestion[]

  createdAt DateTime @default(now())

  @@index([questionPaperId, questionNo])
}

model Option {
  id         Int     @id @default(autoincrement())
  questionId Int
  label      String // "A", "B", "C", "D"
  text       String
  // Optional picture for the option (a map, chart, diagram) — a path on this
  // server such as /uploads/abc.png. `text` may be empty when this is set.
  imageUrl   String?
  isCorrect  Boolean @default(false)

  question          Question        @relation(fields: [questionId], references: [id])
  selectedInAnswers AttemptAnswer[]

  @@unique([questionId, label])
}

enum AttemptMode {
  FULL_PAPER
  CATEGORY_PRACTICE
}

// How a FULL_PAPER attempt is run. EXAM mirrors the real Prelims: one overall
// timer, no feedback until submission, UPSC marking (+2 / -2/3). PRACTICE is
// untimed and reveals the answer, explanation and revision points after each
// question. See lib/paper-test.ts.
enum TestMode {
  EXAM
  PRACTICE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// One quiz session — either replaying a full past paper or a mixed-category practice set.
model QuizAttempt {
  id                Int         @id @default(autoincrement())
  userId            String
  mode              AttemptMode
  questionPaperId   Int? // set only when mode = FULL_PAPER
  // FULL_PAPER only: restricts the attempt to one subject section of the
  // paper (null = the whole paper).
  sectionCategoryId Int?
  testMode          TestMode    @default(PRACTICE)
  // EXAM mode time limit, fixed at creation (see lib/paper-test.ts).
  durationSeconds   Int?
  // UPSC-style marks, set on completion: +2 correct, -2/3 wrong, 0 skipped.
  score             Float?
  maxScore          Float?
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  totalQuestions    Int
  correctCount      Int         @default(0)
  wrongCount        Int         @default(0)
  skippedCount      Int         @default(0)

  user            User              @relation(fields: [userId], references: [id])
  questionPaper   QuestionPaper?    @relation(fields: [questionPaperId], references: [id])
  sectionCategory Category?         @relation("AttemptSection", fields: [sectionCategoryId], references: [id])
  categories      AttemptCategory[]
  answers         AttemptAnswer[]
}

// Which categories were selected for a CATEGORY_PRACTICE attempt.
model AttemptCategory {
  id         Int @id @default(autoincrement())
  attemptId  Int
  categoryId Int

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id])
  category Category    @relation(fields: [categoryId], references: [id])

  @@unique([attemptId, categoryId])
}

// A single answered (or skipped) question within an attempt.
// Weak-category stats are computed on demand by joining this to Question -> Category,
// no separate stats table needed at this scale.
model AttemptAnswer {
  id               Int      @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int? // null = skipped
  isCorrect        Boolean  @default(false)
  answeredAt       DateTime @default(now())

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id])
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

// ==========================================================================
// Stage-based learning (gamified "missions" layer over Category/Question)
// A category's questions are auto-grouped into fixed batches of 10 by
// StageBuilder (see lib/stage-builder.ts) — never hand-edited. Question
// membership always goes through StageQuestion, never a stored range, so
// question order/composition can change without touching stage records.
// ==========================================================================

enum StageProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

model Stage {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  stageNumber   Int
  title         String
  foodWorldName String?
  questionCount Int
  rewardStars   Int      @default(3)
  unlockOrder   Int
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions StageQuestion[]
  progress  UserStageProgress[]

  @@unique([categoryId, stageNumber])
}

// Maps questions to stages. Never derive membership from an id range —
// always go through this table so question order can be changed later.
model StageQuestion {
  id           Int @id @default(autoincrement())
  stageId      Int
  questionId   Int
  displayOrder Int

  stage    Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([stageId, questionId])
}

// A user's progress on one stage. Only created once a user starts or
// completes a stage — LOCKED/UNLOCKED status for untouched stages is
// computed on read (see lib/continue-learning.ts / categories/[id] route),
// not persisted, matching AttemptAnswer's "no separate stats table" approach.
model UserStageProgress {
  id                 Int                 @id @default(autoincrement())
  userId             String
  stageId            Int
  completedQuestions Int                 @default(0)
  correctAnswers     Int                 @default(0)
  accuracy           Float               @default(0)
  starsEarned        Int                 @default(0)
  status             StageProgressStatus @default(IN_PROGRESS)
  startedAt          DateTime            @default(now())
  completedAt        DateTime?

  user  User  @relation(fields: [userId], references: [id])
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
}

// A user's latest attempt at a single question, independent of which stage
// it was answered in — also carries the bookmark flag.
model UserQuestionProgress {
  id             Int      @id @default(autoincrement())
  userId         String
  questionId     Int
  selectedOption Int?
  isCorrect      Boolean  @default(false)
  timeTaken      Int?
  attemptedAt    DateTime @default(now())
  bookmarked     Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

// A daily mixed-category challenge, one row per calendar day. Lazily created
// on first request for that day (see lib/daily-challenge.ts) — there's no
// cron/job runner in this codebase, so nothing pre-generates it at midnight.
model DailyChallenge {
  id            Int      @id @default(autoincrement())
  challengeDate DateTime @unique
  questionCount Int
  createdAt     DateTime @default(now())

  questions DailyChallengeQuestion[]
  progress  UserDailyChallengeProgress[]
}

model DailyChallengeQuestion {
  id           Int @id @default(autoincrement())
  challengeId  Int
  questionId   Int
  displayOrder Int

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question  Question       @relation(fields: [questionId], references: [id])

  @@unique([challengeId, questionId])
}

// Once-a-day attempt at a DailyChallenge — unlike UserStageProgress, replay
// is blocked once completedAt is set (see the submit route).
model UserDailyChallengeProgress {
  id                 Int       @id @default(autoincrement())
  userId             String
  challengeId        Int
  completedQuestions Int       @default(0)
  correctAnswers     Int       @default(0)
  accuracy           Float     @default(0)
  starsEarned        Int       @default(0)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  user      User           @relation(fields: [userId], references: [id])
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

// ==========================================================================
// Question-bank import / review pipeline
// Raw questions extracted from PDFs land here for human review before being
// promoted into the live Question/Option models above.
// ==========================================================================

model Paper {
  id        Int             @id @default(autoincrement())
  year      Int
  name      String // e.g., "GS1", "CSAT"
  set       String? // e.g., "A", "B", "C", "D"
  questions DraftQuestion[]
  imports   Import[]

  @@unique([year, name, set])
}

model DraftQuestion {
  id            Int     @id @default(autoincrement())
  questionNo    Int
  text          String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  optionAImage  String?
  optionBImage  String?
  optionCImage  String?
  optionDImage  String?
  correctAnswer String?

  explanation       String?
  explanationSource String?
  revisionPoints    String?
  reviewed          Boolean @default(false)

  questionImage    String?
  optionImage      String?
  imageType        String? // e.g., "MAP", "CHART", "TABLE", "DIAGRAM", "GENERAL"
  imageBoundingBox String? // JSON string storing coordinates or OCR bbox

  parseConfidence    Float @default(0.0)
  categoryConfidence Float @default(0.0)
  answerConfidence   Float @default(0.0)

  status String @default("NEEDS_REVIEW") // NEEDS_REVIEW or APPROVED

  paperId Int
  paper   Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  tags        QuestionTag[]
  reviewQueue ReviewQueue?

  @@unique([paperId, questionNo])
}

model QuestionTag {
  questionId Int
  tagId      Int
  question   DraftQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model Import {
  id        Int         @id @default(autoincrement())
  paperId   Int
  paper     Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  status    String // SUCCESS, PARTIAL, FAILED
  logs      ImportLog[]
}

model ImportLog {
  id        Int      @id @default(autoincrement())
  importId  Int
  import    Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  message   String
  level     String // INFO, WARN, ERROR
  createdAt DateTime @default(now())
}

model ReviewQueue {
  id         Int           @id @default(autoincrement())
  questionId Int           @unique
  question   DraftQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reason     String // e.g., "Low Category Confidence", "Missing Options"
  resolved   Boolean       @default(false)
  createdAt  DateTime      @default(now())
}
